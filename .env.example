# ==============================================================================
# FlashSale Engine - Environment Configuration Template
# Copy this file to .env before starting the stack
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=flashsale_db
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale_secret
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flashsale_db

# Redis Configuration
REDIS_PORT=6379
REDIS_HOST=localhost

# Apache Kafka Configuration
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service Ports
GATEWAY_PORT=8080
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083

# Inter-service URLs (for Gateway / Local calls)
ORDER_SERVICE_URI=http://localhost:8081
INVENTORY_SERVICE_URI=http://localhost:8082

# Payment Simulation Defaults
PAYMENT_SIMULATION_MODE=ALWAYS_SUCCESS
PAYMENT_SIMULATION_LATENCY_MS=50
